#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

export EDITOR="codium"
export PKG_CONFIG_PATH=/usr/lib/wlroots0.17/pkgconfig:$PKG_CONFIG_PATH
export godot4=/usr/bin/godot-mono

#alias code='codium'
alias ls='ls -a --color=auto'
alias grep='grep --color=auto'
alias yay='yay --editmenu'
# systemctl --user restart hypridle.service && 
alias reload='chezmoi apply && hyprctl reload && 
systemctl --user restart hyprpaper.service
# &&
#sudo keyd reload'

alias godot-build='dotnet build && godot-mono'

alias sys-up-down='sudo pacman -Syyuu && shutdown now'

alias fix-arduino="sudo chmod a+rw /dev/ttyUSB0"

alias resonite="WEBKIT_DISABLE_COMPOSITING_MODE=1 gale"

PS1='[\u@\h \W]\$ '

if [ -n "$CONTAINER_ID" ]; then
    echo "Entering distrobox: $CONTAINER_ID"
    # strip any inherited pyenv shims from PATH
    export PATH=$(echo "$PATH" | tr ':' '\n' | grep -v "$HOME/.pyenv" | paste -sd:)

    source /opt/ros/jazzy/setup.bash
    source /opt/ros/jazzy/local_setup.bash
    export ROS_DOMAIN_ID=41
else
    export PYENV_ROOT="$HOME/.pyenv"
    [[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
    eval "$(pyenv init - bash)"
fi


#Rust
. "$HOME/.cargo/env"

#Rust for esp variables
. $HOME/export-esp.sh

fastfetch